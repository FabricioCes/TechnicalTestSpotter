# Variables to set in the Dokploy "Environment" tab (or in a local .env for
# docker compose). Never commit real values.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Your public domain, e.g. trucks.example.com (add the VPS IP too if you use it)
DJANGO_ALLOWED_HOSTS=trucks.example.com
# Leave empty: the frontend proxies /api, so the browser never makes cross-origin calls
CORS_ALLOWED_ORIGINS=
