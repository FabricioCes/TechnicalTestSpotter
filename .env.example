# Copy to .env and change the values before deploying.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=0
# Public hostname(s) of the VPS, comma-separated, e.g. trucks.example.com,203.0.113.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origin(s). The Nginx proxy makes calls same-origin, so this is only a fallback.
CORS_ALLOWED_ORIGINS=http://localhost
